# 宿主机 nginx 反向代理示例（应用只监听 127.0.0.1:3000）
#
# 放到 /etc/nginx/conf.d/toolbox.conf，证书用你自己的方式签发即可。
# 应用不需要知道域名，也不需要配置 HTTPS —— 它只认 HTTP + 转发头。

server {
    listen 80;
    server_name tool.example.com;
    # 如果用 certbot 签证书，保留这一行自动跳转
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tool.example.com;

    ssl_certificate     /etc/letsencrypt/live/tool.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tool.example.com/privkey.pem;

    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # 必须：让应用拿到真实 Host / 协议 / 客户端 IP
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 300s;
    }
}
