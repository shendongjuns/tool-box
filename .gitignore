# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# 桌面端
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# 数据（本地 SQLite / 备份）
#
# 注意：data/ 必须写成 /data/（只忽略仓库根目录下的），
# 不能写成 data/ —— 后者会匹配任意层级的 data 目录，
# 把 packages/data/ 这样的源码目录也一起忽略掉。
/data/
*.db
*.db-shm
*.db-wal
*.db.prev
apps/server/data/
apps/server/public/

# 数据库备份（可能含全部业务数据）
*.bak
*.bak-wal
*.bak-shm

# 加密密钥 —— 丢了就解不开已存的 SSH 凭据，
# 泄露了等于把所有凭据交出去
.credential-key
*.credential-key

# git bundle 备份（内含完整历史）
*.bundle
toolbox-backup-*

# 环境变量
.env
.env.*
!.env.example

# 日志
logs/
*.log

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 临时目录
.tmp-*/
